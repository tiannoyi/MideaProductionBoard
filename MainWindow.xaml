<Window x:Class="MideaProductionBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MideaProductionBoard"
        Title="麒麟实业有限公司制作 - 总装分厂一线" 
        Height="915" 
        Width="1245"
        WindowStartupLocation="CenterScreen"
        Background="#0D47A1"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <!-- 字体大小转换器 -->
        <local:FontSizeConverter x:Key="FontSizeConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="MinHeight" Value="35"/>
        </Style>

        <Storyboard x:Key="BlinkAnimation" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0.3"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <!-- 主布局网格 - 进一步减少边距 -->
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 第0行：顶部区域（日期+Midea+标题） -->
            <RowDefinition Height="Auto"/>
            <!-- 第1行：系统配置区域 -->
            <RowDefinition Height="Auto"/>
            <!-- 第2行：PLC状态警告 -->
            <RowDefinition Height="*"/>
            <!-- 第3行：生产数据显示区域 -->
            <RowDefinition Height="Auto"/>
            <!-- 第4行：状态信息 -->
            <RowDefinition Height="Auto"/>
            <!-- 第5行：操作按钮区域 -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- 第0列：左侧内容 -->
            <ColumnDefinition Width="10"/>
            <!-- 第1列：间隔 -->
            <ColumnDefinition Width="*"/>
            <!-- 第2列：右侧内容 -->
        </Grid.ColumnDefinitions>

        <!-- 顶部区域：进一步紧凑布局 -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,2,0,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 第一行：Midea Logo、主标题和日期时间 -->
            <Grid Grid.Row="0" Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Midea Logo - 进一步放大 -->
                <TextBlock Grid.Column="0" 
                          Text="Midea" 
                          FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=60}" 
                          FontWeight="Bold" 
                          VerticalAlignment="Center"/>

                <!-- 主标题：总装一分厂除湿机线 - 进一步放大 -->
                <TextBlock Grid.Column="1" 
                          Text="总装一分厂除湿机线" 
                          FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=65}" 
                          FontWeight="Bold" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"/>

                <!-- 日期时间显示 -->
                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentDate}" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=18}" 
                              HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CurrentTime}" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=28}" 
                              FontWeight="Bold"
                              HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- 第二行：英文副标题 - 进一步放大 -->
            <TextBlock Grid.Row="1" 
                      Text="Dehumidifier Line of General Assembly No.1 Branch"
                      FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=32}" 
                      HorizontalAlignment="Center" 
                      Margin="0,2,0,5"/>
        </Grid>

        <!-- 系统配置区域 - 更加紧凑 -->
        <GroupBox Grid.Row="1" 
                  Grid.ColumnSpan="3" 
                  Header="系统配置" 
                  Foreground="White" 
                  BorderBrush="#64B5F6" 
                  Padding="3"
                  Margin="0,2,0,5">
            <Grid Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 第0行：PLC连接状态信息 -->
                <TextBlock Grid.Row="0" 
                          Grid.Column="0" 
                          Text="PLC连接状态:" 
                          FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=18}" 
                          VerticalAlignment="Center" 
                          Margin="0,0,10,5"/>

                <TextBlock Grid.Row="0" 
                          Grid.Column="1" 
                          x:Name="txtConnectionStatus" 
                          Text="未连接" 
                          FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=18}" 
                          VerticalAlignment="Center" 
                          Margin="0,0,20,5"/>

                <TextBlock Grid.Row="0" 
                          Grid.Column="2" 
                          Text="PLC地址:" 
                          FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=18}" 
                          VerticalAlignment="Center" 
                          Margin="0,0,10,5"/>

                <TextBlock Grid.Row="0" 
                          Grid.Column="3" 
                          x:Name="txtPlcAddress" 
                          Text="192.168.1.30:4998" 
                          FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=18}" 
                          VerticalAlignment="Center" 
                          Margin="0,0,20,5"/>

                <Button Grid.Row="0" 
                        Grid.Column="4" 
                        Content="工作时间设置" 
                        x:Name="btnWorkTimeSettings" 
                        Click="BtnWorkTimeSettings_Click" 
                        Margin="0,0,10,5"/>

                <TextBlock Grid.Row="0" 
                          Grid.Column="5" 
                          x:Name="txtPlcInfo" 
                          Text="" 
                          FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=18}" 
                          VerticalAlignment="Center" 
                          Margin="0,0,0,5"/>

                <!-- 第1行：生产计划信息 -->
                <TextBlock Grid.Row="1" 
                          Grid.Column="0" 
                          Text="当天计划总产量:" 
                          FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=18}" 
                          VerticalAlignment="Center" 
                          Margin="0,5,10,0"/>

                <TextBox Grid.Row="1" 
                         Grid.Column="1" 
                         x:Name="txtPlanTotalOutput" 
                         Text="3400" 
                         Margin="0,5,20,0"/>

                <TextBlock Grid.Row="1" 
                          Grid.Column="2" 
                          Text="有效工作时间:" 
                          FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=18}" 
                          VerticalAlignment="Center" 
                          Margin="0,5,10,0"/>

                <TextBlock Grid.Row="1" 
                          Grid.Column="3" 
                          x:Name="txtEffectiveWorkTime" 
                          Text="10小时" 
                          FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=18}" 
                          VerticalAlignment="Center" 
                          Margin="0,5,20,0"/>

                <Button Grid.Row="1" 
                        Grid.Column="4" 
                        Content="更新计划" 
                        x:Name="btnUpdatePlan" 
                        Click="BtnUpdatePlan_Click" 
                        Margin="0,5,10,0"/>

                <TextBlock Grid.Row="1" 
                          Grid.Column="5" 
                          x:Name="txtPlanStatus" 
                          Text="计划未更新" 
                          FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=18}" 
                          VerticalAlignment="Center" 
                          Margin="0,5,0,0"/>
            </Grid>
        </GroupBox>

        <!-- PLC状态警告边框 -->
        <Border Grid.Row="2" 
                Grid.ColumnSpan="3" 
                x:Name="borderPlcStatus" 
                Background="#D32F2F"
                CornerRadius="5" 
                Padding="8" 
                Visibility="Collapsed" 
                Margin="0,2,0,5">
            <TextBlock x:Name="txtPlcStatusAlert" 
                      Text="PLC未连接通讯异常" 
                      FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=20}" 
                      FontWeight="Bold" 
                      HorizontalAlignment="Center"
                      Foreground="White"/>
        </Border>

        <!-- 生产数据展示区域 - 使用UniformGrid确保均匀分布，进一步增大数值显示 -->
        <UniformGrid Grid.Row="3" 
                     Grid.ColumnSpan="3" 
                     Columns="2"
                     Rows="3"
                     Margin="0,0,0,3">

            <!-- 当天计划总产量 -->
            <Border Background="#1976D2" 
                    CornerRadius="10" 
                    Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                              Text="当天计划总产量" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=34}" 
                              FontWeight="SemiBold"
                              Margin="0,3,0,0"/>

                    <TextBlock Grid.Row="1" 
                              Text="Total output of today" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=28}" 
                              Opacity="0.9" 
                              Margin="0,2,0,5"/>

                    <!-- 使用Viewbox确保数值自适应大小，大幅增大最大高度和字体 -->
                    <Viewbox Grid.Row="2" 
                             Stretch="Uniform" 
                             MaxHeight="150"  
                        MaxWidth="400"
                        HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <TextBlock x:Name="txtTotalOutput" 
                                  Text="0" 
                                  FontSize="120"  
                                  FontWeight="Bold" 
                                  Foreground="Yellow"/>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- 当前累计到达量 -->
            <Border Background="#1976D2" 
                    CornerRadius="10" 
                    Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                              Text="当前累计到达量" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=34}" 
                              FontWeight="SemiBold"
                              Margin="0,3,0,0"/>

                    <TextBlock Grid.Row="1" 
                              Text="Now total Output" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=28}" 
                              Opacity="0.9" 
                              Margin="0,2,0,5"/>

                    <!-- 使用Viewbox确保数值自适应大小，大幅增大最大高度和字体 -->
                    <Viewbox Grid.Row="2" 
                             Stretch="Uniform" 
                             MaxHeight="150"
                             MaxWidth="400"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <TextBlock x:Name="txtCumulativeOutput" 
                                  Text="0" 
                                  FontSize="120"
                                  FontWeight="Bold" 
                                  Foreground="Red"/>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- 平均线小时目标产量 -->
            <Border Background="#1976D2" 
                    CornerRadius="10" 
                    Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                              Text="平均线小时目标产量" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=32}" 
                              FontWeight="SemiBold"
                              Margin="0,3,0,0"/>

                    <TextBlock Grid.Row="1" 
                              Text="The average UPH" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=26}" 
                              Opacity="0.9" 
                              Margin="0,2,0,5"/>

                    <!-- 使用Viewbox确保数值自适应大小，大幅增大最大高度和字体 -->
                    <Viewbox Grid.Row="2" 
                             Stretch="Uniform" 
                             MaxHeight="150"
                             MaxWidth="400"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <TextBlock x:Name="txtAverageUPH" 
                                  Text="0" 
                                  FontSize="120"
                                  FontWeight="Bold" 
                                  Foreground="Yellow"/>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- 上小时实际产量 -->
            <Border Background="#1976D2" 
                    CornerRadius="10" 
                    Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                              Text="上小时实际产量" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=32}" 
                              FontWeight="SemiBold"
                              Margin="0,3,0,0"/>

                    <TextBlock Grid.Row="1" 
                              Text="Last hour UPH" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=26}" 
                              Opacity="0.9" 
                              Margin="0,2,0,5"/>

                    <!-- 使用Viewbox确保数值自适应大小，大幅增大最大高度和字体 -->
                    <Viewbox Grid.Row="2" 
                             Stretch="Uniform" 
                             MaxHeight="150"
                             MaxWidth="400"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <TextBlock x:Name="txtLastHourUPH" 
                                  Text="0" 
                                  FontSize="120"
                                  FontWeight="Bold" 
                                  Foreground="Red"/>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- 平均实际线小时产量 -->
            <Border Background="#1976D2" 
                    CornerRadius="10" 
                    Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                              Text="平均实际线小时产量" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=30}" 
                              FontWeight="SemiBold"
                              Margin="0,3,0,0"/>

                    <TextBlock Grid.Row="1" 
                              Text="The actual UPH" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=24}" 
                              Opacity="0.9" 
                              Margin="0,2,0,5"/>

                    <!-- 使用Viewbox确保数值自适应大小，大幅增大最大高度和字体 -->
                    <Viewbox Grid.Row="2" 
                             Stretch="Uniform" 
                             MaxHeight="150"
                             MaxWidth="400"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <TextBlock x:Name="txtActualUPH" 
                                  Text="0" 
                                  FontSize="120"
                                  FontWeight="Bold" 
                                  Foreground="Red"/>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- 本小时实际产量 -->
            <Border Background="#1976D2" 
                    CornerRadius="10" 
                    Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                              Text="本小时实际产量" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=32}" 
                              FontWeight="SemiBold"
                              Margin="0,3,0,0"/>

                    <TextBlock Grid.Row="1" 
                              Text="This hour UPH" 
                              FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=26}" 
                              Opacity="0.9" 
                              Margin="0,2,0,5"/>

                    <!-- 使用Viewbox确保数值自适应大小，大幅增大最大高度和字体 -->
                    <Viewbox Grid.Row="2" 
                             Stretch="Uniform" 
                             MaxHeight="150"
                             MaxWidth="400"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <TextBlock x:Name="txtThisHourUPH" 
                                  Text="0" 
                                  FontSize="120"
                                  FontWeight="Bold" 
                                  Foreground="Red"/>
                    </Viewbox>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- 状态信息显示 -->
        <TextBlock Grid.Row="4" 
                  Grid.ColumnSpan="3" 
                  x:Name="txtStatus" 
                  FontSize="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=16}" 
                  HorizontalAlignment="Center" 
                  Margin="0,0,0,3"
                  Text="等待连接PLC..."/>

        <!-- 操作按钮区域 -->
        <Border Grid.Row="5" 
                Grid.ColumnSpan="3" 
                Background="Transparent" 
                Padding="3" 
                Margin="0,3,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- 左侧空白 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 开始监控按钮 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 停止监控按钮 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 手动刷新按钮 -->
                    <ColumnDefinition Width="*"/>
                    <!-- 右侧空白 -->
                </Grid.ColumnDefinitions>

                <!-- 控制按钮 -->
                <Button Grid.Column="1" 
                        Content="开始监控" 
                        x:Name="btnStart" 
                        Click="BtnStart_Click" 
                        MinWidth="120"/>
                <Button Grid.Column="2" 
                        Content="停止监控" 
                        x:Name="btnStop" 
                        Click="BtnStop_Click" 
                        MinWidth="120"/>
                <Button Grid.Column="3" 
                        Content="手动刷新" 
                        x:Name="btnRefresh" 
                        Click="BtnRefresh_Click" 
                        MinWidth="120"/>
            </Grid>
        </Border>
    </Grid>
</Window>