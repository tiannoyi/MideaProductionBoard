<Window x:Class="MideaProductionBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="麒麟实业有限公司制作 - 总装分厂一线" Height="915" Width="1245"
        WindowStartupLocation="CenterScreen"
        Background="#0D47A1">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="MinHeight" Value="35"/>
        </Style>
        <Storyboard x:Key="BlinkAnimation" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0.3"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Margin="15,-5,0,57" Grid.Column="2" Grid.RowSpan="2" RenderTransformOrigin="0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding CurrentDate}" FontSize="15" 
                      HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding CurrentTime}" FontSize="20" 
                      HorizontalAlignment="Right" VerticalAlignment="Center"/>


        </Grid>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="总装一分厂除湿机线" 
                   FontSize="45" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="Midea" 
           FontSize="40" FontWeight="Bold"  
           Margin="0,14,0,43" Grid.RowSpan="2"/>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Dehumidifier Line of General Assembiy No.1 Branch"
                   FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <Border Grid.Row="3" Grid.ColumnSpan="3" x:Name="borderPlcStatus" 
                Background="#D32F2F" CornerRadius="5" Padding="10" 
                Visibility="Collapsed" Margin="0,0,0,15">
            <TextBlock x:Name="txtPlcStatusAlert" Text="PLC未连接通讯异常" 
                      FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                      Foreground="White"/>
        </Border>
        <GroupBox Grid.Row="4" Grid.ColumnSpan="4" Header="系统配置" Foreground="White" 
                  BorderBrush="#64B5F6" Margin="0,0,0,15">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC连接状态:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtConnectionStatus" Text="未连接" 
                          VerticalAlignment="Center" Margin="0,0,20,5"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="PLC地址:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtPlcAddress" Text="192.168.1.30:4998" 
                          VerticalAlignment="Center" Margin="0,0,20,5"/>

                <Button Grid.Row="0" Grid.Column="4" Content="工作时间设置" x:Name="btnWorkTimeSettings" 
                       Click="BtnWorkTimeSettings_Click" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="5" x:Name="txtPlcInfo" Text="" 
                          VerticalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="当天计划总产量:" VerticalAlignment="Center" Margin="0,5,10,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPlanTotalOutput" Text="3400" Margin="0,5,400,0"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="有效工作时间:" VerticalAlignment="Center" Margin="0,5,10,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtEffectiveWorkTime" Text="10小时" VerticalAlignment="Center" Margin="0,5,20,0"/>

                <Button Grid.Row="1" Grid.Column="4" Content="更新计划" x:Name="btnUpdatePlan" Click="BtnUpdatePlan_Click" Margin="0,5,10,0"/>
                <TextBlock Grid.Row="1" Grid.Column="5" x:Name="txtPlanStatus" Text="计划未更新" 
                          VerticalAlignment="Center" Margin="0,5,0,0"/>
            </Grid>
        </GroupBox>
        <Grid Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Background="#1976D2" CornerRadius="5" Padding="20" Margin="0,0,0,10" >
                    <StackPanel>
                        <TextBlock Text="当天计划总产量" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="Total output of today" FontSize="30" Opacity="0.8" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtTotalOutput" Text="0" FontSize="50" FontWeight="Bold" Foreground="Yellow"
                                  HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1976D2" CornerRadius="5" Padding="20" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="平均线小时目标产量" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="The average UPH" FontSize="30" Opacity="0.8" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtAverageUPH" Text="0" FontSize="50" FontWeight="Bold" Foreground="Yellow"
                                  HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1976D2" CornerRadius="5" Padding="20" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="平均实际线小时产量" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="The actual UPH" FontSize="30" Opacity="0.8" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtActualUPH" Text="0" FontSize="50" FontWeight="Bold" Foreground="Red"
                                  HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Border  Background="#1976D2" CornerRadius="5" Padding="20" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="当前累计到达量" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="Now total Output" FontSize="30" Opacity="0.8" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtCumulativeOutput" Text="0" FontSize="50" FontWeight="Bold" Foreground="Red"
                         HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1976D2" CornerRadius="5" Padding="20" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="上小时实际产量" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Last hour UPH" FontSize="30" Opacity="0.8" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtLastHourUPH" Text="0" FontSize="50" FontWeight="Bold" Foreground="Red"
                                  HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1976D2" CornerRadius="5" Padding="20" Margin="0,0,0,10" >
                    <StackPanel>
                        <TextBlock Text="本小时实际产量" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="This hour UPH" FontSize="30" Opacity="0.8" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtThisHourUPH" Text="0" FontSize="50" FontWeight="Bold" Foreground="Red"
                                  HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="7" Grid.ColumnSpan="3" x:Name="txtStatus" 
                   FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10"
                   Text="等待连接PLC..."/>
        <Border Grid.Row="8" Grid.ColumnSpan="3" Background="Transparent" 
                Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="开始监控" x:Name="btnStart" 
                       Click="BtnStart_Click" MinWidth="120"/>
                <Button Grid.Column="2" Content="停止监控" x:Name="btnStop" 
                       Click="BtnStop_Click" MinWidth="120"/>
                <Button Grid.Column="3" Content="手动刷新" x:Name="btnRefresh" 
                       Click="BtnRefresh_Click" MinWidth="120"/>
            </Grid>
        </Border>
    </Grid>
</Window>