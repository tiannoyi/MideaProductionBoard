<Window x:Class="MideaProductionBoard.WorkTimeSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作时间设置" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#0D47A1">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="工作时间设置" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="工作开始时间:" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="txtStartHour" Text="8" Width="40" Margin="5,0,5,0"/>
            <TextBlock Text="时" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBox x:Name="txtStartMinute" Text="0" Width="40" Margin="5,0,5,0"/>
            <TextBlock Text="分" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="工作结束时间:" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="txtEndHour" Text="18" Width="40" Margin="5,0,5,0"/>
            <TextBlock Text="时" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBox x:Name="txtEndMinute" Text="0" Width="40" Margin="5,0,5,0"/>
            <TextBlock Text="分" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="午休开始时间:" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="txtLunchStartHour" Text="12" Width="40" Margin="5,0,5,0"/>
            <TextBlock Text="时" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBox x:Name="txtLunchStartMinute" Text="0" Width="40" Margin="5,0,5,0"/>
            <TextBlock Text="分" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="午休结束时间:" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="txtLunchEndHour" Text="13" Width="40" Margin="5,0,5,0"/>
            <TextBlock Text="时" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBox x:Name="txtLunchEndMinute" Text="0" Width="40" Margin="5,0,5,0"/>
            <TextBlock Text="分" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="txtWorkTimeInfo" FontSize="12" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="保存设置" Click="BtnSave_Click"/>
            <Button Content="取消" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window> 