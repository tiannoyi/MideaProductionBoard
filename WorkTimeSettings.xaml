<Window x:Class="MideaProductionBoard.WorkTimeSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="工作时间设置" 
        Height="600" Width="650"
        WindowStartupLocation="CenterOwner"
        MinHeight="550" MinWidth="600"
        Background="#0D47A1"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- 颜色资源 -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#0D47A1"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2196F3"/>
        <SolidColorBrush x:Key="TextColor" Color="White"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#FF5252"/>
        <SolidColorBrush x:Key="InfoBgColor" Color="#1565C0"/>
        <SolidColorBrush x:Key="RestTimeBgColor" Color="#1A3A6F"/>
        <SolidColorBrush x:Key="RestTimeTextColor" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="RestTimeBorderColor" Color="#2979FF"/>
        <SolidColorBrush x:Key="RestTimeContainerBgColor" Color="#0D2E6B"/>

        <!-- 文本样式 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

        <Style x:Key="RestTimeLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource RestTimeTextColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 输入框样式 -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- 休息时间输入框样式 -->
        <Style x:Key="RestTimeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Background" Value="{StaticResource SecondaryColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="5,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 添加休息时间按钮样式 -->
        <Style x:Key="AddRestTimeButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <!-- 删除按钮样式 -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="MinWidth" Value="65"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F44336"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 休息时间项模板 -->
        <DataTemplate x:Key="RestTimeTemplate">
            <Border Background="{StaticResource RestTimeBgColor}" CornerRadius="6" 
                    Padding="15,12" Margin="0,8" BorderBrush="{StaticResource RestTimeBorderColor}" 
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标签 -->
                    <TextBlock Grid.Column="0" Text="休息时间:"
                               Style="{StaticResource RestTimeLabelStyle}"
                               Width="90" Margin="0,0,15,0"/>

                    <!-- 时间输入区域 -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 开始时间 -->
                        <TextBox Grid.Column="0" x:Name="txtRestStartHour" 
                                 Text="{Binding StartHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource RestTimeTextBoxStyle}"
                                 PreviewTextInput="NumberValidationTextBox"
                                 TextChanged="RestTimeTextBox_TextChanged"/>
                        <TextBlock Grid.Column="1" Text="时" Style="{StaticResource RestTimeLabelStyle}" Margin="8,0"/>
                        <TextBox Grid.Column="2" x:Name="txtRestStartMinute" 
                                 Text="{Binding StartMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=00}" 
                                 Style="{StaticResource RestTimeTextBoxStyle}"
                                 PreviewTextInput="NumberValidationTextBox"
                                 TextChanged="RestTimeTextBox_TextChanged"/>
                        <TextBlock Grid.Column="3" Text="分" Style="{StaticResource RestTimeLabelStyle}" Margin="8,0,15,0"/>

                        <!-- 分隔符 -->
                        <TextBlock Grid.Column="4" Text="至" Style="{StaticResource RestTimeLabelStyle}" Margin="10,0"/>

                        <!-- 结束时间 -->
                        <TextBox Grid.Column="5" x:Name="txtRestEndHour" 
                                 Text="{Binding EndHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource RestTimeTextBoxStyle}"
                                 PreviewTextInput="NumberValidationTextBox"
                                 TextChanged="RestTimeTextBox_TextChanged"/>
                        <TextBlock Grid.Column="6" Text="时" Style="{StaticResource RestTimeLabelStyle}" Margin="8,0"/>
                        <TextBox Grid.Column="7" x:Name="txtRestEndMinute" 
                                 Text="{Binding EndMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=00}" 
                                 Style="{StaticResource RestTimeTextBoxStyle}"
                                 PreviewTextInput="NumberValidationTextBox"
                                 TextChanged="RestTimeTextBox_TextChanged"/>
                        <TextBlock Grid.Column="8" Text="分" Style="{StaticResource RestTimeLabelStyle}" Margin="8,0"/>
                    </Grid>

                    <!-- 删除按钮 -->
                    <Button Grid.Column="2" Content="删除" Style="{StaticResource DeleteButtonStyle}"
                            Click="DeleteRestTime_Click" Tag="{Binding}"
                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="工作时间设置" 
                   Style="{StaticResource HeaderTextStyle}" 
                   Margin="0,0,0,20"/>

        <!-- 工作时间设置 -->
        <Border Grid.Row="1" BorderBrush="#1E88E5" BorderThickness="0,0,0,1" 
                Padding="0,0,0,20" Margin="0,0,0,20">
            <StackPanel>
                <!-- 工作开始时间 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="工作开始时间:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="txtStartHour" Text="8" 
                             PreviewTextInput="NumberValidationTextBox"
                             TextChanged="TimeTextBox_TextChanged"/>
                    <TextBlock Text="时" Margin="8,0,25,0" FontSize="14" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtStartMinute" Text="00" 
                             PreviewTextInput="NumberValidationTextBox"
                             TextChanged="TimeTextBox_TextChanged"/>
                    <TextBlock Text="分" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- 工作结束时间 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="工作结束时间:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="txtEndHour" Text="18" 
                             PreviewTextInput="NumberValidationTextBox"
                             TextChanged="TimeTextBox_TextChanged"/>
                    <TextBlock Text="时" Margin="8,0,25,0" FontSize="14" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtEndMinute" Text="00" 
                             PreviewTextInput="NumberValidationTextBox"
                             TextChanged="TimeTextBox_TextChanged"/>
                    <TextBlock Text="分" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 休息时间列表 -->
        <Border Grid.Row="2" BorderBrush="#1E88E5" BorderThickness="0,0,0,1" 
                Padding="0,0,0,15" Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="休息时间设置" Style="{StaticResource LabelTextStyle}"/>
                    <Button x:Name="btnAddRestTime" Content="添加休息时间" 
                            Click="BtnAddRestTime_Click" 
                            Style="{StaticResource AddRestTimeButtonStyle}"/>
                </StackPanel>

                <Border BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="4" 
                        Padding="12" MaxHeight="220" Background="{StaticResource RestTimeContainerBgColor}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RestTimesItemsControl" 
                                      ItemTemplate="{StaticResource RestTimeTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- 工作时间信息 -->
        <Border Grid.Row="3" Background="{StaticResource InfoBgColor}" 
                CornerRadius="5" Padding="15" Margin="0,10,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtWorkTimeInfo" FontSize="13" 
                           FontFamily="Microsoft YaHei"
                           TextWrapping="Wrap" MinHeight="100"/>
            </ScrollViewer>
        </Border>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="保存设置" Click="BtnSave_Click" IsDefault="True"
                    Padding="20,10" FontSize="14" FontWeight="SemiBold"/>
            <Button Content="取消" Click="BtnCancel_Click" IsCancel="True"
                    Padding="20,10" FontSize="14" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>