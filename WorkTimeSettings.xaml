<Window x:Class="MideaProductionBoard.WorkTimeSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="工作时间设置" 
        Height="460" Width="450"  
    WindowStartupLocation="CenterOwner"
        MinHeight="400" MinWidth="420"
    Background="#0D47A1"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Height">
    <!-- 自动调整高度适应内容 -->

    <Window.Resources>
        <!-- 颜色资源 -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#0D47A1"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2196F3"/>
        <SolidColorBrush x:Key="TextColor" Color="White"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#FF5252"/>
        <SolidColorBrush x:Key="InfoBgColor" Color="#1565C0"/>

        <!-- 文本样式 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Width" Value="110"/>
            <!-- 增加了标签宽度 -->
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- 输入框样式 -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="Width" Value="45"/>
            <!-- 增加了文本框宽度 -->
            <Setter Property="Height" Value="28"/>
            <!-- 增加了文本框高度 -->
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- 按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Background" Value="{StaticResource SecondaryColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
            <!-- 增加了按钮最小宽度 -->
            <Setter Property="Height" Value="35"/>
            <!-- 增加了按钮高度 -->
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <!-- 为信息区域设置最小高度 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <!-- 底部留白 -->
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="工作时间设置" 
                   Style="{StaticResource HeaderTextStyle}" 
                   Margin="0,0,0,20"/>

        <!-- 时间设置区域 -->
        <Border Grid.Row="1" BorderBrush="#1E88E5" BorderThickness="0,0,0,1" 
                Padding="0,0,0,15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 工作开始时间 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="工作开始时间:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="txtStartHour" Text="8" 
                             PreviewTextInput="NumberValidationTextBox"/>
                    <TextBlock Text="时" Margin="5,0,20,0"/>
                    <TextBox x:Name="txtStartMinute" Text="00" 
                             PreviewTextInput="NumberValidationTextBox"/>
                    <TextBlock Text="分" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- 工作结束时间 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="工作结束时间:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="txtEndHour" Text="18" 
                             PreviewTextInput="NumberValidationTextBox"/>
                    <TextBlock Text="时" Margin="5,0,20,0"/>
                    <TextBox x:Name="txtEndMinute" Text="00" 
                             PreviewTextInput="NumberValidationTextBox"/>
                    <TextBlock Text="分" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- 午休开始时间 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="午休开始时间:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="txtLunchStartHour" Text="12" 
                             PreviewTextInput="NumberValidationTextBox"/>
                    <TextBlock Text="时" Margin="5,0,20,0"/>
                    <TextBox x:Name="txtLunchStartMinute" Text="00" 
                             PreviewTextInput="NumberValidationTextBox"/>
                    <TextBlock Text="分" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- 午休结束时间 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <TextBlock Text="午休结束时间:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="txtLunchEndHour" Text="13" 
                             PreviewTextInput="NumberValidationTextBox"/>
                    <TextBlock Text="时" Margin="5,0,20,0"/>
                    <TextBox x:Name="txtLunchEndMinute" Text="00" 
                             PreviewTextInput="NumberValidationTextBox"/>
                    <TextBlock Text="分" Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工作时间信息 -->
        <Border Grid.Row="5" Background="{StaticResource InfoBgColor}" 
                CornerRadius="5" Padding="15" Margin="0,10,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="工作时间信息" 
                           FontWeight="Bold" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtWorkTimeInfo" FontSize="12" 
                               TextWrapping="Wrap" MinHeight="60"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="保存设置" Click="BtnSave_Click" IsDefault="True"/>
            <Button Content="取消" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>